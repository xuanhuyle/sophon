    "claimed_approval_id"
   ],
   "title": "Equivalence",
   "type": "object"
  },
  "GoverningSource": {
   "additionalProperties": false,
   "properties": {
    "clause_id": {
     "title": "Clause Id",
     "type": "string"
    },
    "clause_version": {
     "minimum": 1,
     "title": "Clause Version",
     "type": "integer"
    },
    "content_sha256": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Content Sha256",
     "type": "string"
    },
    "effective_from": {
     "format": "date",
     "title": "Effective From",
     "type": "string"
    },
    "effective_to": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Effective To"
    },
    "observed_at": {
     "format": "date-time",
     "title": "Observed At",
     "type": "string"
    },
    "path": {
     "title": "Path",
     "type": "string"
    },
    "provenance": {
     "const": "LAB_AUTHORED",
     "title": "Provenance",
     "type": "string"
    },
    "source_id": {
     "title": "Source Id",
     "type": "string"
    }
   },
   "required": [
    "source_id",
    "path",
    "content_sha256",
    "clause_id",
    "clause_version",
    "observed_at",
    "effective_from",
    "effective_to",
    "provenance"
   ],
   "title": "GoverningSource",
   "type": "object"
  },
