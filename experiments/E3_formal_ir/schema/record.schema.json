{
 "$defs": {
  "Atom": {
   "additionalProperties": false,
   "properties": {
    "aggregation": {
     "anyOf": [
      {
       "enum": [
        "SUM",
        "COUNT_DISTINCT"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Aggregation"
    },
    "atom_id": {
     "title": "Atom Id",
     "type": "string"
    },
    "fact_kind": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Fact Kind"
    },
    "grain": {
     "anyOf": [
      {
       "const": "ORDER_LINE",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Grain"
    },
    "kind": {
     "enum": [
      "MEASURE",
      "PREDICATE",
      "GROUP_BY"
     ],
     "title": "Kind",
     "type": "string"
    },
    "op": {
     "anyOf": [
      {
       "enum": [
        "EQ",
        "GE",
        "IS_TRUE"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Op"
    },
    "period": {
     "anyOf": [
      {
       "const": "CALENDAR_YEAR",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Period"
    },
    "span": {
     "maxItems": 2,
     "minItems": 2,
     "prefixItems": [
      {
       "type": "integer"
      },
      {
       "type": "integer"
      }
     ],
     "title": "Span",
     "type": "array"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "unit": {
     "anyOf": [
      {
       "enum": [
        "CURRENCY",
        "CURRENCY_PER_UNIT",
        "UNIT",
        "COUNT"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Unit"
    },
    "value": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    }
   },
   "required": [
    "atom_id",
    "span",
    "text",
    "kind",
    "fact_kind"
   ],
   "title": "Atom",
   "type": "object"
  },
  "Binding": {
   "additionalProperties": false,
   "properties": {
    "derivation": {
     "anyOf": [
      {
       "$ref": "#/$defs/Derivation"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "equivalence": {
     "anyOf": [
      {
       "$ref": "#/$defs/Equivalence"
      },
      {
       "type": "null"
      }
     ],
     "default": null
