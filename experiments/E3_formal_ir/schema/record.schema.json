      "type": "string"
     },
     "title": "Guards Declared",
     "type": "array"
    },
    "line_entity": {
     "title": "Line Entity",
     "type": "string"
    },
    "numerator_metric": {
     "title": "Numerator Metric",
     "type": "string"
    },
    "pattern": {
     "const": "LINE_GRAIN_RATIO_THRESHOLD",
