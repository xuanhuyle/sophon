     "type": "string"
    },
    "threshold": {
     "title": "Threshold",
     "type": "string"
    }
   },
   "required": [
    "pattern",
    "numerator_metric",
    "denominator_metric",
    "line_entity",
    "threshold",
    "guards_declared",
    "guard_receipt_id"
   ],
   "title": "Derivation",
   "type": "object"
  },
  "Equivalence": {
   "additionalProperties": false,
   "properties": {
    "claimed_approval_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Claimed Approval Id"
    },
    "fact_kind": {
     "title": "Fact Kind",
     "type": "string"
    },
    "field": {
     "title": "Field",
     "type": "string"
    },
    "statement": {
     "title": "Statement",
     "type": "string"
    }
   },
   "required": [
    "field",
    "fact_kind",
