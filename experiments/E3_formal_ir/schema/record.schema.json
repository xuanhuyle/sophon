     "type": "array"
    },
    "semantic_object": {
     "anyOf": [
      {
       "$ref": "#/$defs/SemanticObject"
      },
      {
       "type": "null"
      }
     ]
    },
    "value_override": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
