     "value": "20263fa531d3b3c946f80a85fc863cd1d004b9b2b907f75de32faf100853a957"
    }
   ],
   "rehash_v2_approval": false
  },
  {
   "control_id": "N1B_SOURCE_HASH_MISSING",
