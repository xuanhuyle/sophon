     ],
     "value": "125"
    }
   ],
   "rehash_v2_approval": true
  },
  {
   "control_id": "N1H_UNIT_CHANGED",
   "description": "v2 threshold unit changed to CURRENCY_PER_KG (approval re-bound to the altered claim)",
   "ops": [
    {
     "op": "set",
     "path": [
      "requirement_versions",
      "P1_v2",
      "requirement",
      "atoms",
