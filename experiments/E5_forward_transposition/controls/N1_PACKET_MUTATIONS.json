     "op": "set",
     "path": [
      "requirement_versions",
      "P1_v2",
      "governing_source",
      "content_sha256"
     ],
     "value": null
    }
   ],
   "rehash_v2_approval": false
  },
  {
   "control_id": "N1C_APPROVAL_MISSING",
