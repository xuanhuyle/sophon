    "source_scope": {
      "sql": "\n        select count(*) as raw_records,\n               count(*) filter(where VendorID is null) as missing_vendor,\n               count(*) filter(where tpep_pickup_datetime >= timestamp '2025-01-01'\n                 and tpep_pickup_datetime < timestamp '2025-02-01') as january_pickups,\n               min(tpep_pickup_datetime) as earliest_pickup,\n               max(tpep_pickup_datetime) as latest_pickup\n        from bronze.yellow_tripdata_raw",
      "columns": [
        "raw_records",
        "missing_vendor",
        "january_pickups",
        "earliest_pickup",
        "latest_pickup"
      ],
